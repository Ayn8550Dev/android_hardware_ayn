    <string name="calibration_title">Calibrare Joystick</string>
    <string name="calibration_intro_description">Acest asistent va calibra bețele analogice:\n\n1. Centru — lăsați ambele bețe relaxate\n2-3. Gamă — rotiți fiecare băț într-un cerc complet\n4-5. Zonă moartă - trageți și eliberați fiecare băț de mai multe ori\n\nFiecare pas avansează odată ce sunt colectate suficiente date.</string>
    <string name="calibration_start">Pornire</string>
    <string name="calibration_cancel">Anulare</string>
    <string name="calibration_phase_center_title">Pasul 1: Centru</string>
    <string name="calibration_phase_center_desc">Lăsați ambele bețe centrate și relaxate. Următorul va apărea odată ce citirile sunt stabile.</string>
    <string name="calibration_phase_range_left_title">Pasul 2: Gamă Băț Stânga</string>
    <string name="calibration_phase_range_left_desc">Rotiți încet bățul din stânga în cercuri întregi, ajungând la toate extremele. Următorul va apărea odată ce este detectat un interval suficient.</string>
    <string name="calibration_phase_range_right_title">Pasul 3: Gamă Băț Dreapta</string>
    <string name="calibration_phase_range_right_desc">Rotiți încet bățul din dreapta în cercuri întregi, ajungând la toate extremele. Următorul va apărea odată ce este detectat un interval suficient.</string>
    <string name="calibration_phase_deadzone_left_title">Pasul 4: Zonă Moartă Băț Stânga</string>
    <string name="calibration_phase_deadzone_left_desc">Trageţi bățul din stânga către margine şi eliberaţi-l. Repetaţi de cel puţin 3 ori din direcţii diferite. Următorul va apărea odată ce sunt colectate suficiente date stabile.</string>
    <string name="calibration_phase_deadzone_right_title">Pasul 5: Zonă Moartă Băț Dreapta</string>
    <string name="calibration_phase_deadzone_right_desc">Trageţi bățul din dreapta către margine şi eliberaţi-l. Repetaţi de cel puţin 3 ori din direcţii diferite. Următorul va apărea odată ce sunt colectate suficiente date stabile.</string>
    <string name="calibration_next">Următorul</string>
    <string name="calibration_accept">Acceptați</string>
    <string name="calibration_retry">Reîncercați</string>
    <string name="calibration_test_title">Testare calibrare</string>
    <string name="calibration_test_desc">Comparați înainte și după. Bețele calibrate ar trebui să se centreze curat și să ajungă la toate marginile.</string>
    <string name="calibration_test_before">Înainte (brut)</string>
