    <string name="calibration_test_title">Kalibrasiyanı test et</string>
    <string name="calibration_test_desc">Əvvəl və sonrasını müqayisə edin. Kalibrlənmiş çubuqlar düzgün formada mərkəzlənməli və bütün kənarlara çatmalıdır.</string>
