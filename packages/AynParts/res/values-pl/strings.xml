    <string name="calibration_test_title">Sprawdź kalibrację</string>
    <string name="calibration_test_desc">Porównaj stan przed i po. Skalibrowane drążki powinny być równo wycentrowane i dosięgać wszystkich krawędzi.</string>
    <string name="calibration_test_before">Przed (nieprzetworzone)</string>
