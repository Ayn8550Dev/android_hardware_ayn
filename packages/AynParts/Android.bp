android_app {
    name: "AynParts",
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.kt"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
    ],

    required: [
        "moorechip_gamepad_idc",
        "moorechip_gamepad_kl",
        "ueventd.aynparts.rc",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },
}

prebuilt_etc {
    name: "ueventd.aynparts.rc",
    filename: "ueventd.rc",
    src: "configs/init/ueventd.aynparts.rc",
    device_specific: true,
}

prebuilt_usr_idc {
    name: "moorechip_gamepad_idc",
    srcs: ["configs/idc/*.idc"],
    soc_specific: true,
}

prebuilt_usr_keylayout {
    name: "moorechip_gamepad_kl",
    srcs: ["configs/keylayout/*.kl"],
    soc_specific: true,
}
