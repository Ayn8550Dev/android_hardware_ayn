cc_binary {
    name: "recovery_rgb",

    init_rc: ["recovery_rgb.rc"],

    shared_libs: [
        "libbase",
        "libcutils",
    ],

    srcs: ["main.cpp"],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    recovery: true,
}
