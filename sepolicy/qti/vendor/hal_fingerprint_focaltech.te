type hal_fingerprint_focaltech, domain;
type hal_fingerprint_focaltech_exec, exec_type, vendor_file_type, file_type;

binder_call(hal_fingerprint_focaltech, hal_fingerprint_default)
vndbinder_use(hal_fingerprint_focaltech)

allow hal_fingerprint_focaltech hal_fingerprint_default:fd use;
allow hal_fingerprint_focaltech hal_fingerprint_default:fifo_file rw_file_perms;
allow hal_fingerprint_focaltech hal_fingerprint_default:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_focaltech hal_fingerprint_default:netlink_socket create_socket_perms_no_ioctl;

allow hal_fingerprint_focaltech fingerprint_vendor_data_file:dir create_dir_perms;
allow hal_fingerprint_focaltech fingerprint_vendor_data_file:file create_file_perms;

allow hal_fingerprint_focaltech {
    focal_fingerprint_device
    tee_device
}:chr_file rw_file_perms;

allow hal_fingerprint_focaltech focal_fingerprint_service:service_manager find;
