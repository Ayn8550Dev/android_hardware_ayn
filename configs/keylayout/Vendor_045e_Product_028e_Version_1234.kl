# Moorechip Gamepad

key 304   BUTTON_A
key 305   BUTTON_B
key 307   BUTTON_X
key 308   BUTTON_Y

key 310   BUTTON_L1
key 311   BUTTON_R1

key 312   BUTTON_L2
key 313   BUTTON_R2

key 317   BUTTON_THUMBL
key 318   BUTTON_THUMBR

key 158   BACK
key 314   BUTTON_SELECT
key 315   BUTTON_START
key 102   HOME

key 306   BUTTON_C
key 309   BUTTON_Z
key 316   BUTTON_MODE
key 583   ASSIST
key 580   APP_SWITCH
key 591   DO_NOT_DISTURB
key 224   BRIGHTNESS_DOWN
key 225   BRIGHTNESS_UP
key 114   VOLUME_DOWN
key 115   VOLUME_UP
key 99    SYSRQ
key 116   POWER

axis 0x00 X
axis 0x01 Y
axis 0x03 Z
axis 0x04 RZ

axis 0x02 LTRIGGER
axis 0x05 RTRIGGER

axis 0x10 HAT_X
axis 0x11 HAT_Y
